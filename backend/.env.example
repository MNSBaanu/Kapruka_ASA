# Secret: set this in your host's secrets panel in production, never commit it.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash
# Tried in order when a model hits its (per-model) free-tier limit.
GEMINI_FALLBACK_MODELS=models/gemini-flash-latest,models/gemini-3.1-flash-lite,models/gemini-3-flash-preview
# 0 turns off "thinking" on gemini-2.5-flash for faster replies. Leave empty for models that can't disable it.
GEMINI_THINKING_BUDGET=0
MCP_ENDPOINT=https://mcp.kapruka.com/mcp
MCP_TIMEOUT=30
CACHE_TTL_SECONDS=900
DELIVERY_CACHE_TTL_SECONDS=60
MAX_HISTORY=40
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=2000
CHAT_RATE_PER_MINUTE=20
# Local dev: `python -m app.main` listens on APP_PORT (8000, which the Vite dev proxy expects).
# Hosting: run.sh listens on $PORT when the host sets it, otherwise 8080 (Replit).
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=*
